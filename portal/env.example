# USGate Portal — copy to .env and fill in. NEVER commit .env.
# All values below are PLACEHOLDERS for demo / public code.

# --- App ---
APP_NAME=USGate Portal
APP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_64chars_min
APP_HOST=0.0.0.0
APP_PORT=8080
APP_BASE_URL=https://portal.example.com
# Single switch: true = mock panel; false = real 3X-UI adapter
MOCK_XUI=true
# When MOCK_XUI=false: if true, fall back to mock on panel errors (default OFF)
MOCK_XUI_FALLBACK=false
# Cookie / session
SESSION_COOKIE_NAME=usgate_session
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE_SECONDS=86400

# --- Bootstrap admin (created once if no users exist) ---
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- 3X-UI panel (ignored when MOCK_XUI=true) ---
# Example: http://VPS_IP:2053/PANEL_PATH
XUI_BASE_URL=http://VPS_IP:2053/PANEL_PATH
XUI_USERNAME=PANEL_ADMIN_USER
XUI_PASSWORD=PANEL_ADMIN_PASSWORD
# Optional API token instead of session login (if panel supports it)
XUI_API_TOKEN=
# Default inbound id for new clients
XUI_INBOUND_ID=1
# Subscription public base, e.g. http://VPS_IP:2096/SUB_PATH
XUI_SUB_BASE_URL=http://VPS_IP:2096/SUB_PATH

# --- Rate limits ---
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
# Global per-IP request budget (0 disables)
GLOBAL_RATE_LIMIT=120
GLOBAL_RATE_WINDOW_SECONDS=60

# --- SQLite ---
DATABASE_URL=sqlite+aiosqlite:///./data/usgate.db
